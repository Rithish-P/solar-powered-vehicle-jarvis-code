import socket
import speech_recognition as sr

ESP_IP = "192.168.137.58"
ESP_PORT = 333

def send_command(cmd):
    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.settimeout(5)
    try:
        client.connect((ESP_IP, ESP_PORT))
        client.sendall((cmd + "\n").encode())
        print("SENT:", cmd)
    except Exception as e:
        print("Connection Error:", e)
    finally:
        client.close()

def get_command(text):
    text = text.lower()
    if "stop" in text:
        return "STOP"
    if "forward" in text:
        return "FORWARD"
    if "backward" in text or "back" in text:
        return "BACKWARD"
    if "left" in text or "lift" in text:
        return "RIGHT"
    if "right" in text or "write" in text:
        return "LEFT"
    return None

recognizer = sr.Recognizer()

print("JARVIS READY. Say: forward, backward, left, right, stop. Say 'exit' to quit.")

with sr.Microphone() as source:
    recognizer.adjust_for_ambient_noise(source, duration=1)

    while True:
        print("Listening...")
        try:
            audio = recognizer.listen(source, timeout=5, phrase_time_limit=3)
            text = recognizer.recognize_google(audio)
            print("You said:", text)

            if "exit" in text.lower():
                send_command("STOP")
                print("JARVIS OFF")
                break

            cmd = get_command(text)
            if cmd:
                send_command(cmd)
            else:
                print("Command purila, ignore panren")

        except sr.WaitTimeoutError:
            pass
        except sr.UnknownValueError:
            print("Purila, thirumba sollu")
        except sr.RequestError as e:
            print("Internet error:", e)
